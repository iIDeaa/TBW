  m_Script: {fileID: 11500000, guid: 53dabb081c1ceba448a791498f4d38d4, type: 3}
  m_Name: D1
  m_EditorClassIdentifier: 
  lines:
  - speaker: Dr. Dea
    text: "\u0E2D\u0E32 . . . . \u0E2D\u0E22\u0E32\u0E01\u0E23\u0E39\u0E49\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E1B\u0E25\u0E01
      \u0E46  \u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E40\u0E01\u0E34\u0E14\u0E02\u0E36\u0E49\u0E19\u0E07\u0E31\u0E49\u0E19\u0E40\u0E2B\u0E23\u0E2D"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E08\u0E23\u0E34\u0E07 \u0E46  \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E40\u0E23\u0E32\u0E01\u0E47\u0E22\u0E31\u0E07\u0E23\u0E39\u0E49\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E21\u0E48\u0E21\u0E32\u0E01\u0E2B\u0E23\u0E2D\u0E01
      \u0E23\u0E39\u0E49\u0E41\u0E04\u0E48\u0E27\u0E48\u0E32\u0E15\u0E31\u0E27\u0E1E\u0E27\u0E01\u0E19\u0E31\u0E49\u0E19\u0E21\u0E31\u0E19\u0E40\u0E01\u0E34\u0E14\u0E21\u0E32\u0E08\u0E32\u0E01\u0E04\u0E32\u0E23\u0E3A\u0E1A\u0E2D\u0E19\u0E41\u0E25\u0E49\u0E27\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E01\u0E47\u0E01\u0E33\u0E25\u0E31\u0E07\u0E1B\u0E48\u0E27\u0E19\u0E44\u0E1B\u0E17\u0E31\u0E48\u0E27\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E2D\u0E22\u0E39\u0E48"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E41\u0E25\u0E49\u0E27\u0E04\u0E32\u0E23\u0E4C\u0E1A\u0E2D\u0E19\u0E43\u0E19\u0E17\u0E38\u0E01\u0E17\u0E35\u0E48\u0E01\u0E47\u0E04\u0E48\u0E2D\u0E22
      \u0E46  \u0E2A\u0E39\u0E07\u0E02\u0E36\u0E49\u0E19\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E22
      \u0E46  \u0E0B\u0E36\u0E48\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E43\u0E19
      \u0E01\u0E32\u0E0B\u0E40\u0E25\u0E37\u0E2D\u0E19\u0E01\u0E23\u0E30\u0E08\u0E01
      \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E42\u0E25\u0E01\u0E02\u0E2D\u0E07\u0E40\u0E23\u0E32\u0E01\u0E47\u0E40\u0E25\u0E22\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E40\u0E02\u0E49\u0E32\u0E2A\u0E39\u0E48\u0E2A\u0E20\u0E32\u0E27\u0E30
      \u0E42\u0E25\u0E01\u0E40\u0E14\u0E37\u0E2D\u0E14"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E2A\u0E48\u0E27\u0E19\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E01\u0E47\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E08\u0E49\u0E32\u0E15\u0E31\u0E27\u0E17\u0E35\u0E48\u0E19\u0E32\u0E22\u0E40\u0E2B\u0E47\u0E19\u0E01\u0E47\u0E44\u0E14\u0E49
      \u0E41\u0E15\u0E48\u0E08\u0E23\u0E34\u0E07 \u0E46 \u0E41\u0E25\u0E49\u0E27
      \u0E01\u0E34\u0E08\u0E01\u0E23\u0E23\u0E21\u0E43\u0E19\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E27\u0E31\u0E19\u0E02\u0E2D\u0E07\u0E40\u0E23\u0E32\u0E01\u0E47\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E01\u0E4A\u0E32\u0E0B\u0E40\u0E2B\u0E25\u0E48\u0E32\u0E19\u0E35\u0E49\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E44\u0E14\u0E49\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E44\u0E21\u0E48\u0E27\u0E48\u0E32\u0E08\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E32\u0E23\u0E43\u0E0A\u0E49\u0E23\u0E16\u0E22\u0E19\u0E15\u0E4C
      \u0E01\u0E32\u0E23\u0E40\u0E1B\u0E34\u0E14\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1B\u0E23\u0E31\u0E1A\u0E2D\u0E32\u0E01\u0E32\u0E28
      \u0E01\u0E32\u0E23\u0E43\u0E0A\u0E49\u0E44\u0E1F\u0E1F\u0E49\u0E32 \u0E2B\u0E23\u0E37\u0E2D\u0E41\u0E21\u0E49\u0E41\u0E15\u0E48\u0E01\u0E32\u0E23\u0E01\u0E33\u0E08\u0E31\u0E14\u0E02\u0E22\u0E30\u0E44\u0E21\u0E48\u0E16\u0E39\u0E01\u0E27\u0E34\u0E18\u0E35
      \u0E40\u0E0A\u0E48\u0E19 \u0E40\u0E1C\u0E32\u0E02\u0E22\u0E30 \u0E2A\u0E34\u0E48\u0E07\u0E40\u0E2B\u0E25\u0E48\u0E32\u0E19\u0E35\u0E49\u0E25\u0E49\u0E27\u0E19\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E1B\u0E23\u0E34\u0E21\u0E32\u0E13\u0E01\u0E4A\u0E32\u0E0B\u0E40\u0E23\u0E37\u0E2D\u0E19\u0E01\u0E23\u0E30\u0E08\u0E01\u0E42\u0E14\u0E22\u0E17\u0E35\u0E48\u0E40\u0E23\u0E32\u0E2D\u0E32\u0E08\u0E44\u0E21\u0E48\u0E17\u0E31\u0E19\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E01\u0E4A\u0E32\u0E0B\u0E40\u0E2B\u0E25\u0E48\u0E32\u0E19\u0E35\u0E49\u0E2A\u0E30\u0E2A\u0E21\u0E21\u0E32\u0E01\u0E02\u0E36\u0E49\u0E19
      \u0E04\u0E27\u0E32\u0E21\u0E23\u0E49\u0E2D\u0E19\u0E01\u0E47\u0E16\u0E39\u0E01\u0E01\u0E31\u0E01\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E27\u0E49\u0E43\u0E19\u0E0A\u0E31\u0E49\u0E19\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E01\u0E32\u0E28
      \u0E2A\u0E48\u0E07\u0E1C\u0E25\u0E43\u0E2B\u0E49\u0E2D\u0E38\u0E13\u0E2B\u0E20\u0E39\u0E21\u0E34\u0E42\u0E25\u0E01\u0E2A\u0E39\u0E07\u0E02\u0E36\u0E49\u0E19
      \u0E41\u0E25\u0E30\u0E40\u0E01\u0E34\u0E14\u0E01\u0E32\u0E23\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E41\u0E1B\u0E25\u0E07\u0E2A\u0E20\u0E32\u0E1E\u0E20\u0E39\u0E21\u0E34\u0E2D\u0E32\u0E01\u0E32\u0E28
      \u0E41\u0E25\u0E30\u0E2A\u0E48\u0E07\u0E1C\u0E25\u0E15\u0E48\u0E2D\u0E2A\u0E34\u0E48\u0E07\u0E21\u0E35\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E15\u0E48\u0E32\u0E07
      \u0E46  \u0E23\u0E27\u0E21\u0E16\u0E36\u0E07\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E02\u0E48\u0E32\u0E27\u0E14\u0E35\u0E01\u0E47\u0E04\u0E37\u0E2D...
      \u0E17\u0E38\u0E01\u0E04\u0E19\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E0A\u0E48\u0E27\u0E22\u0E25\u0E14\u0E01\u0E32\u0E23\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E01\u0E4A\u0E32\u0E0B\u0E04\u0E32\u0E23\u0E4C\u0E1A\u0E2D\u0E19\u0E44\u0E14\u0E49
      \u0E40\u0E23\u0E34\u0E48\u0E21\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E1B\u0E23\u0E30\u0E2B\u0E22\u0E31\u0E14\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19
      \u0E01\u0E32\u0E23\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E21\u0E32\u0E43\u0E0A\u0E49\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E2A\u0E30\u0E2D\u0E32\u0E14 
      \u0E1B\u0E25\u0E39\u0E01\u0E15\u0E49\u0E19\u0E44\u0E21\u0E49 \u0E41\u0E25\u0E30\u0E25\u0E14\u0E01\u0E32\u0E23\u0E43\u0E0A\u0E49\u0E2A\u0E34\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E08\u0E33\u0E40\u0E1B\u0E47\u0E19
      \u0E40\u0E1B\u0E47\u0E19\u0E15\u0E49\u0E19"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
  - speaker: Dr. Dea
    text: "\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E07\u0E31\u0E49\u0E19\u0E09\u0E31\u0E19\u0E08\u0E30\u0E43\u0E2B\u0E49\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E01\u0E31\u0E1A\u0E19\u0E32\u0E22
      \u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D \" Carbon Meter \"  \u0E21\u0E31\u0E19\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E19\u0E32\u0E22\u0E15\u0E23\u0E27\u0E08\u0E27\u0E31\u0E14\u0E41\u0E25\u0E30\u0E23\u0E39\u0E49\u0E44\u0E14\u0E49\u0E16\u0E36\u0E07\u0E1B\u0E23\u0E34\u0E21\u0E32\u0E13\u0E04\u0E32\u0E23\u0E4C\u0E1A\u0E2D\u0E19\u0E43\u0E19\u0E41\u0E15\u0E48\u0E25\u0E30\u0E17\u0E35\u0E48\n\u0E17\u0E35\u0E19\u0E35\u0E49\u0E01\u0E47\u0E44\u0E1B\u0E44\u0E14\u0E49\u0E41\u0E25\u0E49\u0E27\u0E09\u0E31\u0E19\u0E22\u0E31\u0E07\u0E21\u0E35\u0E07\u0E32\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E17\u0E33\u0E2D\u0E35\u0E01"
    portrait: {fileID: 640265826, guid: ab769d5affbc9af439f8c7eef3ffb2b9, type: 3}
    tellimage: {fileID: 0}
